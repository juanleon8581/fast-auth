{
  "name": "fast-auth",
  "version": "1.1.0",
  "description": "Api de Autenticación",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules --watch src/config/docs -r tsconfig-paths/register src/app.ts",
    "build": "jest && tsc",
    "start": "node dist/app.js",
    "prestart": "ts-node -r tsconfig-paths/register src/scripts/generateKeys.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "code:check": "pnpm lint && pnpm format:check",
    "code:fix": "pnpm lint:fix && pnpm format",
    "db:migrate:dev": "dotenv -e .env.dev -- prisma migrate dev",
    "db:migrate:prod": "dotenv -e .env.prod -- prisma migrate deploy",
    "db:push:dev": "dotenv -e .env.dev -- prisma db push",
    "db:push:prod": "dotenv -e .env.prod -- prisma db push",
    "db:studio:dev": "dotenv -e .env.dev -- prisma studio",
    "db:studio:prod": "dotenv -e .env.prod -- prisma studio",
    "db:generate": "prisma generate"
  },
  "keywords": [
    "express",
    "typescript",
    "api",
    "template"
  ],
  "author": "Tu Nombre",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.56.1",
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "prisma": "^6.16.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "winston": "^3.18.3",
    "winston-postgresql": "^1.2.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.1.1",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
